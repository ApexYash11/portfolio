"var Component=(()=>{var p=Object.create;var o=Object.defineProperty;var g=Object.getOwnPropertyDescriptor;var u=Object.getOwnPropertyNames;var m=Object.getPrototypeOf,w=Object.prototype.hasOwnProperty;var f=(t,e)=>()=>(e||t((e={exports:{}}).exports,e),e.exports),y=(t,e)=>{for(var r in e)o(t,r,{get:e[r],enumerable:!0})},s=(t,e,r,i)=>{if(e&&typeof e==\"object\"||typeof e==\"function\")for(let a of u(e))!w.call(t,a)&&a!==r&&o(t,a,{get:()=>e[a],enumerable:!(i=g(e,a))||i.enumerable});return t};var b=(t,e,r)=>(r=t!=null?p(m(t)):{},s(e||!t||!t.__esModule?o(r,\"default\",{value:t,enumerable:!0}):r,t)),A=t=>s(o({},\"__esModule\",{value:!0}),t);var h=f((k,l)=>{l.exports=_jsx_runtime});var D={};y(D,{default:()=>d});var n=b(h());function c(t){let e={code:\"code\",h1:\"h1\",h2:\"h2\",img:\"img\",li:\"li\",ol:\"ol\",p:\"p\",pre:\"pre\",...t.components};return(0,n.jsxs)(n.Fragment,{children:[(0,n.jsx)(e.h1,{children:\"Deep Agents: Why Most AI Agents Are Shallow (And How to Fix It)\"}),`\n`,(0,n.jsx)(e.p,{children:\"A complete guide to building AI agents that actually plan, delegate, and remember. Learn the architecture behind Claude Code, Deep Research, and how to build production-ready deep agents with LangChain.\"}),`\n`,(0,n.jsx)(e.p,{children:(0,n.jsx)(e.img,{src:\"/images-deep-agents/cover_photo.png\",alt:\"Deep Agents Architecture\"})}),`\n`,(0,n.jsx)(e.h2,{children:\"Table of Contents\"}),`\n`,(0,n.jsxs)(e.ol,{children:[`\n`,(0,n.jsx)(e.li,{children:\"The Problem: Why Most Agents Are Shallow\"}),`\n`,(0,n.jsx)(e.li,{children:\"What Makes an Agent Deep?\"}),`\n`,(0,n.jsx)(e.li,{children:\"Deep Agents in the Wild\"}),`\n`,(0,n.jsx)(e.li,{children:\"Pillar 1: Planning Tools\"}),`\n`,(0,n.jsx)(e.li,{children:\"Pillar 2: File Systems\"}),`\n`,(0,n.jsx)(e.li,{children:\"Pillar 3: Subagents\"}),`\n`,(0,n.jsx)(e.li,{children:\"Pillar 4: Detailed System Prompts\"}),`\n`,(0,n.jsx)(e.li,{children:\"The Bottom Line\"}),`\n`]}),`\n`,(0,n.jsx)(e.h2,{children:\"The Problem: Why Most Agents Are Shallow\"}),`\n`,(0,n.jsx)(e.p,{children:'You build an AI agent. It can search the web, analyze data, even write code. You give it a task: \"Research the top 5 AI companies hiring in San Francisco, analyze their job openings, and write personalized cover letters for each.\"'}),`\n`,(0,n.jsx)(e.p,{children:\"Your agent searches once. Gets overwhelmed. Writes one generic cover letter. Forgets companies 2 through 5. Fails completely.\"}),`\n`,(0,n.jsx)(e.p,{children:\"This is what I call a shallow agent. Using an LLM to call tools in a loop is the simplest form of an agent, but this architecture yields agents that fail to plan and act over longer, more complex tasks.\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-text\",children:`User: \"Find me jobs and write cover letters for 5 companies\"\\r\n\\r\nShallow Agent Process:\\r\n\\u2192 Searches: \"AI companies SF hiring\"\\r\n\\u2192 Gets 50 results, context starts filling up\\r\n\\u2192 Picks first company, writes generic letter\\r\n\\u2192 Tries to continue but context is full of search results\\r\n\\u2192 Forgets the task had 5 companies\\r\n\\u2192 Returns incomplete work\\r\n\\r\nResult: FAILURE\n`})}),`\n`,(0,n.jsx)(e.p,{children:\"Now watch what happens with a deep agent:\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-text\",children:`User: \"Find me jobs and write cover letters for 5 companies\"\\r\n\\r\nDeep Agent Process:\\r\n\\u2192 Writes TODO list:\\r\n   1. Search for AI companies in SF\\r\n   2. Research each company (spawn subagent for each)\\r\n   3. Find job openings for each\\r\n   4. Write personalized cover letters\\r\n\\u2192 Executes step 1: Searches broadly\\r\n\\u2192 Stores company list in companies.md file\\r\n\\u2192 For each company:\\r\n   \\u2192 Spawns research subagent with isolated context\\r\n   \\u2192 Subagent deep-dives on that company\\r\n   \\u2192 Stores findings in company_X_research.md\\r\n\\u2192 Reads research files\\r\n\\u2192 Writes 5 personalized, specific cover letters\\r\n\\r\nResult: SUCCESS\n`})}),`\n`,(0,n.jsx)(e.h2,{children:\"What Makes an Agent Deep?\"}),`\n`,(0,n.jsx)(e.p,{children:\"The difference is not the core algorithm. Both agents are just LLMs running in a loop calling tools. The difference is the architecture around that loop.\"}),`\n`,(0,n.jsx)(e.p,{children:(0,n.jsx)(e.img,{src:\"/images-deep-agents/cover_photo.png\",alt:\"The Four Pillars of Deep Agents\"})}),`\n`,(0,n.jsx)(e.p,{children:\"The four pillars are:\"}),`\n`,(0,n.jsxs)(e.ol,{children:[`\n`,(0,n.jsx)(e.li,{children:\"Planning - breaks down the task before starting\"}),`\n`,(0,n.jsx)(e.li,{children:\"File system - manages context by offloading to files\"}),`\n`,(0,n.jsx)(e.li,{children:\"Subagents - delegates specialized work\"}),`\n`,(0,n.jsx)(e.li,{children:\"Detailed prompts - tells the model how to use the other three\"}),`\n`]}),`\n`,(0,n.jsx)(e.h2,{children:\"Deep Agents in the Wild\"}),`\n`,(0,n.jsx)(e.p,{children:\"Claude Code, OpenAI Deep Research, and Manus all converged on the same pattern.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Claude Code's TODO list tool is effectively a no-op. It does not execute work. It just stores planning steps. That is the point: it forces the agent to think before acting.\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`from langchain_core.tools import tool\\r\n\\r\n@tool\\r\ndef write_todos(todos: list[str]) -> str:\\r\n\t\"\"\"Write or update your TODO list.\"\"\"\\r\n\treturn f\"Updated TODOs: {', '.join(todos)}\"\n`})}),`\n`,(0,n.jsx)(e.p,{children:\"Subagents matter because they keep context isolated and clean. The main agent orchestrates without getting bogged down in the details.\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-mermaid\",children:`graph TB\\r\n\tsubgraph Shallow[Shallow Agent Workflow]\\r\n\t\tS_Start([User]) --> S_Agent[Agent]\\r\n\t\tS_Agent --> S_Tool[Tool]\\r\n\t\tS_Tool --> S_Resp([Response])\\r\n\tend\\r\n\\r\n\tsubgraph Deep[Deep Agent Workflow]\\r\n\t\tD_Start([User]) --> D_Plan[Planning]\\r\n\t\tD_Plan --> D_Loop{Execution Loop}\\r\n\t\tD_Loop -->|Read/Write| D_Files[(Files)]\\r\n\t\tD_Loop -->|Delegate| D_Subs[[Subagents]]\\r\n\t\tD_Loop -->|Direct| D_Tools[Tools]\\r\n\t\tD_Files & D_Subs & D_Tools --> D_Synth[Synthesis]\\r\n\t\tD_Synth --> D_Resp([Response])\\r\n\tend\n`})}),`\n`,(0,n.jsx)(e.h2,{children:\"Pillar 1: Planning Tools\"}),`\n`,(0,n.jsx)(e.p,{children:\"The most important tool in a deep agent does almost nothing. It just stores a list of todos.\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`@tool\\r\ndef write_todos(todos: list[str]) -> str:\\r\n\t\"\"\"\\r\n\tWrite or update your TODO list.\\r\n\\r\n\tUse this to break down complex tasks into steps, track progress,\\r\n\tand update the plan as new information emerges.\\r\n\t\"\"\"\\r\n\treturn f\"Updated TODOs: {', '.join(todos)}\"\n`})}),`\n`,(0,n.jsx)(e.p,{children:\"The value is not in what the tool does. The value is in making the LLM call it.\"}),`\n`,(0,n.jsx)(e.h2,{children:\"Pillar 2: File Systems\"}),`\n`,(0,n.jsx)(e.p,{children:\"You cannot keep everything in the context window forever. Deep agents write findings to files as they discover them, then read only what they need for the current step.\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`# Research a company and store the result\\r\nresearch = agent.internet_search(\"OpenAI company culture\")\\r\nagent.write_file(\"openai_research.md\", research)\\r\n\\r\n# Later, load just what you need\\r\nresearch = agent.read_file(\"openai_research.md\")\\r\nletter = generate_cover_letter(job_posting, research)\n`})}),`\n`,(0,n.jsx)(e.h2,{children:\"Pillar 3: Subagents\"}),`\n`,(0,n.jsx)(e.p,{children:\"Subagents allow parallel work while keeping context isolated.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Without subagents, the main agent context fills with company research, TODOs, and outputs. With subagents, each company gets its own focused context and its own file.\"}),`\n`,(0,n.jsx)(e.h2,{children:\"Pillar 4: Detailed System Prompts\"}),`\n`,(0,n.jsx)(e.p,{children:\"The final pillar is often overlooked. Detailed prompts tell the agent how to plan, when to delegate, and when to store work in files.\"}),`\n`,(0,n.jsx)(e.h2,{children:\"The Bottom Line\"}),`\n`,(0,n.jsx)(e.p,{children:\"The solution is not a different algorithm. It is the same algorithm with four architectural additions: planning, files, subagents, and better prompts.\"}),`\n`,(0,n.jsx)(e.p,{children:`If you want an agent that can handle real work, you need all four.\\r\nA complete guide to building AI agents that actually plan, delegate, and remember. Learn the architecture behind Claude Code, Deep Research, and how to build production-ready deep agents with LangChain.`}),`\n`,(0,n.jsx)(e.h2,{children:\"AI Agents 101: The 60-Second Primer\"}),`\n`,(0,n.jsx)(e.p,{children:\"New to AI agents? Here's what you need to know:\"}),`\n`,(0,n.jsx)(e.p,{children:\"What's an AI agent? An LLM (like ChatGPT) that can use tools to complete tasks. Tools are functions the LLM can call, like search, code execution, database queries, and sending emails.\"}),`\n`,(0,n.jsx)(e.p,{children:\"How do they work? Agents follow a simple loop called the ReAct pattern (Reasoning + Acting):\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-text\",children:`1. Think: \"I need to search for quantum computing news\"\\r\n2. Act: Call search_tool(\"quantum computing 2024\")\\r\n3. Observe: Read the search results\\r\n4. Think: \"Now I have the info, I can answer\"\\r\n5. Respond: Provide answer to user\\r\n\\r\nRepeat until task is complete.\n`})}),`\n`,(0,n.jsx)(e.p,{children:`The ReAct loop works great for simple tasks like \"What's the weather in Tokyo?\" or \"Summarize this article.\"`}),`\n`,(0,n.jsx)(e.p,{children:\"But for complex, multi-step tasks? Simple agents fail spectacularly. They forget steps, lose context, and produce incomplete work.\"}),`\n`,(0,n.jsx)(e.h2,{children:\"Why Most Agents Are Shallow\"}),`\n`,(0,n.jsx)(e.p,{children:'You build an AI agent. It can search the web, analyze data, even write code. You give it a task: \"Research the top 5 AI companies hiring in San Francisco, analyze their job openings, and write personalized cover letters for each.\"'}),`\n`,(0,n.jsx)(e.p,{children:\"Your agent searches once. Gets overwhelmed. Writes one generic cover letter. Forgets companies 2 through 5. Fails completely.\"}),`\n`,(0,n.jsx)(e.p,{children:'This is what I call a \"shallow\" agent. Using an LLM to call tools in a loop is the simplest form of an agent, but this architecture yields agents that fail to plan and act over longer, more complex tasks.'}),`\n`,(0,n.jsx)(e.h2,{children:\"What Happens With a Deep Agent\"}),`\n`,(0,n.jsx)(e.p,{children:\"Deep agents write a plan first, store intermediate findings in files, and delegate focused work to subagents. That lets them handle more complex tasks without losing context.\"}),`\n`,(0,n.jsx)(e.p,{children:\"The difference comes down to four capabilities:\"}),`\n`,(0,n.jsxs)(e.ol,{children:[`\n`,(0,n.jsx)(e.li,{children:\"Planning - Breaks down the task before starting\"}),`\n`,(0,n.jsx)(e.li,{children:\"File system - Manages context by offloading to files\"}),`\n`,(0,n.jsx)(e.li,{children:\"Subagents - Delegates specialized work\"}),`\n`,(0,n.jsx)(e.li,{children:\"Detailed prompts - Knows how to use these capabilities\"}),`\n`]}),`\n`,(0,n.jsx)(e.p,{children:\"Those are the ingredients that make an agent deep.\"})]})}function d(t={}){let{wrapper:e}=t.components||{};return e?(0,n.jsx)(e,{...t,children:(0,n.jsx)(c,{...t})}):c(t)}return A(D);})();\n;return Component;"
"var Component=(()=>{var p=Object.create;var i=Object.defineProperty;var u=Object.getOwnPropertyDescriptor;var m=Object.getOwnPropertyNames;var g=Object.getPrototypeOf,f=Object.prototype.hasOwnProperty;var v=(r,e)=>()=>(e||r((e={exports:{}}).exports,e),e.exports),y=(r,e)=>{for(var t in e)i(r,t,{get:e[t],enumerable:!0})},o=(r,e,t,a)=>{if(e&&typeof e==\"object\"||typeof e==\"function\")for(let s of m(e))!f.call(r,s)&&s!==t&&i(r,s,{get:()=>e[s],enumerable:!(a=u(e,s))||a.enumerable});return r};var C=(r,e,t)=>(t=r!=null?p(g(r)):{},o(e||!r||!r.__esModule?i(t,\"default\",{value:r,enumerable:!0}):t,r)),b=r=>o(i({},\"__esModule\",{value:!0}),r);var c=v((M,l)=>{l.exports=_jsx_runtime});var P={};y(P,{default:()=>h});var n=C(c());function d(r){let e={code:\"code\",h1:\"h1\",h2:\"h2\",h3:\"h3\",img:\"img\",li:\"li\",p:\"p\",pre:\"pre\",strong:\"strong\",table:\"table\",tbody:\"tbody\",td:\"td\",th:\"th\",thead:\"thead\",tr:\"tr\",ul:\"ul\",...r.components};return(0,n.jsxs)(n.Fragment,{children:[(0,n.jsx)(e.h1,{children:\"Model Context Protocol (MCP): The Universal Bridge for AI Applications\"}),`\n`,(0,n.jsx)(e.p,{children:(0,n.jsx)(e.img,{src:\"/images-mcp/connection.jpg\",alt:\"MCP Cover\"})}),`\n`,(0,n.jsx)(e.p,{children:\"Discover how the Model Context Protocol (MCP) simplifies AI integrations. Learn why N\\xD7M integration problems become N+M solutions, and how to implement MCP in your AI applications.\"}),`\n`,(0,n.jsx)(e.h2,{children:\"The Integration Nightmare\"}),`\n`,(0,n.jsx)(e.p,{children:\"You build an AI chatbot. You want it to read files from Google Drive, query your PostgreSQL database, search the web, send Slack messages, and access GitHub repos.\"}),`\n`,(0,n.jsx)(e.p,{children:\"So you write custom code for each one. Five different APIs. Five different authentication flows. Five different error handling patterns. Five maintenance headaches. Now multiply that by every AI application you build. Another AI app means starting over with the same integrations.\"}),`\n`,(0,n.jsx)(e.p,{children:\"This is the N\\xD7M problem. Each AI application (N) needs custom code for each external system (M), giving you N\\xD7M implementations to build and maintain. For 5 apps connecting to 5 services, that's 25 separate integrations. It doesn't scale, it's fragile, and every API change means updating every single client.\"}),`\n`,(0,n.jsx)(e.h2,{children:\"MCP 101\"}),`\n`,(0,n.jsx)(e.p,{children:\"MCP is an open protocol that standardizes how AI applications connect to external systems. It gives the ecosystem a shared language for tools, resources, and prompts. Think of it as the USB-C of AI integrations: one standardized connector instead of dozens of proprietary cables.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Anthropic originally designed MCP for Claude, but it's an open standard. Any AI application can implement an MCP client, and any service can implement an MCP server. They speak the same protocol, regardless of which LLM or framework is running underneath.\"}),`\n`,(0,n.jsx)(e.p,{children:\"What MCP actually is:\"}),`\n`,(0,n.jsxs)(e.ul,{children:[`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"A communication protocol\"}),\" \\u2014 defines how AI apps and services exchange messages\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"A standard for capability discovery\"}),\" \\u2014 servers advertise what they can do, clients discover it dynamically\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"A session lifecycle specification\"}),\" \\u2014 defines initialization, operation, and shutdown phases\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"A JSON-RPC based message format\"}),\" \\u2014 lightweight, language-agnostic request/response pattern\"]}),`\n`]}),`\n`,(0,n.jsx)(e.p,{children:\"What MCP is not:\"}),`\n`,(0,n.jsxs)(e.ul,{children:[`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"A framework or library\"}),\" \\u2014 it's a protocol, not a code framework you build into your app\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"An LLM reasoning system\"}),\" \\u2014 doesn't handle chain-of-thought, planning, or agent logic\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"A prompt engineering tool\"}),\" \\u2014 doesn't manage prompts or system instructions\"]}),`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"A UI or workflow manager\"}),\" \\u2014 doesn't provide dashboards, visual builders, or orchestration\"]}),`\n`]}),`\n`,(0,n.jsx)(e.p,{children:\"The distinction matters because teams often mistake MCP for an agent framework or a drop-in replacement for LangChain/LlamaIndex. It's simpler than that and more powerful because of it. MCP handles the communication layer so your AI applications can focus on reasoning and user experience.\"}),`\n`,(0,n.jsx)(e.h2,{children:\"The N\\xD7M \\u2192 N+M Solution\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-mermaid\",children:`graph LR\\r\n\tsubgraph \"Without MCP (N\\xD7M)\"\\r\n\t\tA1[AI App 1] --> G1[GitHub Client]\\r\n\t\tA1 --> D1[Drive Client]\\r\n\t\tA1 --> P1[Postgres Client]\\r\n\t\tA2[AI App 2] --> G2[GitHub Client]\\r\n\t\tA2 --> D2[Drive Client]\\r\n\t\tA2 --> P2[Postgres Client]\\r\n\tend\\r\n\\r\n\tsubgraph \"With MCP (N+M)\"\\r\n\t\tB1[AI App 1] --> MC1[MCP Client]\\r\n\t\tB2[AI App 2] --> MC2[MCP Client]\\r\n\t\tB3[AI App 3] --> MC3[MCP Client]\\r\n\t\tMC1 & MC2 & MC3 --> MCP[MCP Protocol]\\r\n\t\tMCP --> GS[GitHub Server]\\r\n\t\tMCP --> DS[Drive Server]\\r\n\t\tMCP --> PS[Postgres Server]\\r\n\tend\n`})}),`\n`,(0,n.jsx)(e.p,{children:\"Write each MCP server once. Every MCP-compatible client can use it. Your AI chatbot, VS Code extension, Claude Desktop app, and custom tool can all talk to the same GitHub MCP server. N applications + M servers = N+M implementations instead of N\\xD7M. For 5 apps connecting to 5 services, that's 10 implementations instead of 25. The savings compound as you add more applications or services because each new app instantly gets access to every existing MCP server, and each new server is immediately available to every existing MCP client.\"}),`\n`,(0,n.jsx)(e.h2,{children:\"Architecture: Three Layers\"}),`\n`,(0,n.jsx)(e.p,{children:\"MCP follows a strict three-layer architecture. Understanding this is critical because it dictates how every MCP interaction works.\"}),`\n`,(0,n.jsx)(e.h3,{children:\"1. Host\"}),`\n`,(0,n.jsx)(e.p,{children:\"The AI application your users interact with. This is the top level where the LLM runs and where user-facing features live.\"}),`\n`,(0,n.jsx)(e.p,{children:\"Examples:\"}),`\n`,(0,n.jsxs)(e.ul,{children:[`\n`,(0,n.jsx)(e.li,{children:\"Claude Desktop\"}),`\n`,(0,n.jsx)(e.li,{children:\"VS Code with MCP extension\"}),`\n`,(0,n.jsx)(e.li,{children:\"Cursor IDE\"}),`\n`,(0,n.jsx)(e.li,{children:\"Your custom AI chatbot\"}),`\n`]}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"What hosts do:\"}),\" Display UI to users, run the LLM, manage multiple MCP clients, orchestrate which tools to use, and format responses back to users.\"]}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`# Conceptual MCP Host\\r\nclass MCPHost:\\r\n    def __init__(self):\\r\n        self.clients = []\\r\n        self.llm = ClaudeModel()\\r\n\\r\n    def handle_user_message(self, message):\\r\n        tools_needed = self.llm.analyze(message)\\r\n        for tool in tools_needed:\\r\n            client = self.find_client_for_tool(tool)\\r\n            result = client.call_tool(tool.name, tool.args)\\r\n        return self.llm.format_response(results)\n`})}),`\n`,(0,n.jsx)(e.h3,{children:\"2. Client\"}),`\n`,(0,n.jsxs)(e.p,{children:[\"The mandatory intermediary. This is crucial: \",(0,n.jsx)(e.strong,{children:\"hosts never talk directly to servers\"}),\". One client per server. If your host uses three servers, it creates three clients.\"]}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"Why this matters:\"}),\" Fault isolation (server crash doesn't affect other connections), security boundaries (each client-server pair has isolated permissions), parallel execution (independent request handling per server), and state encapsulation (no shared state, no cross-tool interference).\"]}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"What clients do:\"}),\" Speak the MCP protocol, convert host requests into MCP JSON-RPC messages, convert MCP responses back into host-usable data, manage connection lifecycle, and handle capability negotiation.\"]}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`class MCPClient:\\r\n    def __init__(self, server_connection):\\r\n        self.connection = server_connection\\r\n        self.capabilities = None\\r\n        self.tools = []\\r\n\\r\n    async def initialize(self):\\r\n        response = await self.send_initialize()\\r\n        self.capabilities = response[\"capabilities\"]\\r\n        self.tools = await self.discover_tools()\\r\n\\r\n    async def call_tool(self, name, arguments):\\r\n        request = {\\r\n            \"jsonrpc\": \"2.0\",\\r\n            \"method\": \"tools/call\",\\r\n            \"params\": {\"name\": name, \"arguments\": arguments}\\r\n        }\\r\n        return await self.send(request)\n`})}),`\n`,(0,n.jsx)(e.h3,{children:\"3. Server\"}),`\n`,(0,n.jsx)(e.p,{children:\"The program that exposes capabilities and does actual work. Each server handles one domain \\u2014 GitHub, files, databases, etc.\"}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"What servers do:\"}),\" Advertise capabilities (tools, resources, prompts), execute tool requests, access data (local files, remote APIs, databases), and return structured responses.\"]}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"Example servers:\"}),\" filesystem-server for read/write local files, github-server for GitHub API access, postgres-server for database queries.\"]}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`from mcp.server import Server\\r\n\\r\nserver = Server(\"my-server\")\\r\n\\r\n@server.list_tools()\\r\nasync def list_tools():\\r\n    return [\\r\n        {\\r\n            \"name\": \"add_expense\",\\r\n            \"inputSchema\": {\\r\n                \"type\": \"object\",\\r\n                \"properties\": {\\r\n                    \"amount\": {\"type\": \"number\"},\\r\n                    \"category\": {\"type\": \"string\"}\\r\n                }\\r\n            }\\r\n        }\\r\n    ]\\r\n\\r\n@server.call_tool()\\r\nasync def call_tool(name, arguments):\\r\n    if name == \"add_expense\":\\r\n        db.insert(arguments)\\r\n        return {\"success\": True}\n`})}),`\n`,(0,n.jsx)(e.h3,{children:\"How They Work Together\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-mermaid\",children:`sequenceDiagram\\r\n    participant User\\r\n    participant Host as MCP Host\\r\n    participant Client as MCP Client\\r\n    participant Server as MCP Server\\r\n    participant Data as GitHub API\\r\n\\r\n    User->>Host: \"Show my open PRs\"\\r\n    Host->>Client: Call list_prs()\\r\n    Client->>Server: tools/call(list_prs)\\r\n    Server->>Data: GET /repos/.../pulls\\r\n    Data-->>Server: PR data\\r\n    Server-->>Client: Structured response\\r\n    Client-->>Host: Translated result\\r\n    Host-->>User: \"You have 3 open PRs\"\n`})}),`\n`,(0,n.jsx)(e.p,{children:\"The flow in plain terms: user asks Claude Desktop to show their open PRs, the host runs the LLM which identifies the GitHub tool, the host tells the MCP client to call list_prs, the client converts this to MCP protocol format as a JSON-RPC request, the server receives the request and calls the GitHub API, GitHub returns PR data, the server wraps it in a structured MCP response, the client translates it back to host format, and the LLM generates natural language output for the user. Every MCP interaction follows this same pattern \\u2014 the protocol layer between client and server handles all the standardization, while the host and server focus on their respective jobs.\"}),`\n`,(0,n.jsx)(e.h2,{children:\"How They Work Together\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-mermaid\",children:`sequenceDiagram\\r\n\tparticipant User\\r\n\tparticipant Host as MCP Host\\r\n\tparticipant Client as MCP Client\\r\n\tparticipant Server as MCP Server\\r\n\tparticipant Data as GitHub API\\r\n\\r\n\tUser->>Host: \"Show my open PRs\"\\r\n\tHost->>Client: Call list_prs()\\r\n\tClient->>Server: tools/call(list_prs)\\r\n\tServer->>Data: GET /repos/.../pulls\\r\n\tData-->>Server: PR data\\r\n\tServer-->>Client: Structured response\\r\n\tClient-->>Host: Translated result\\r\n\tHost-->>User: \"You have 3 open PRs\"\n`})}),`\n`,(0,n.jsx)(e.h2,{children:\"Protocol Lifecycle\"}),`\n`,(0,n.jsx)(e.p,{children:\"MCP sessions follow a strict three-phase lifecycle. Understanding this prevents debugging hell later.\"}),`\n`,(0,n.jsx)(e.h3,{children:\"Phase 1: Initialization (The Handshake)\"}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"Hard rule:\"}),\" No tool or resource calls allowed before initialization completes. The client sends an initialize request with its protocol version and capabilities. The server responds with its own capabilities and server info. Once the client sends an \",(0,n.jsx)(e.code,{children:\"initialized\"}),\" notification, the session is live.\"]}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-json\",children:`{\"jsonrpc\": \"2.0\", \"method\": \"initialize\", \"params\": {\\r\n    \"protocolVersion\": \"2024-11-05\",\\r\n    \"capabilities\": {\"tools\": {\"listChanged\": true}},\\r\n    \"clientInfo\": {\"name\": \"my-client\", \"version\": \"1.0.0\"}\\r\n}}\n`})}),`\n`,(0,n.jsxs)(e.p,{children:[\"What's negotiated: protocol version (both must agree), capabilities (what each side supports), and implementation metadata. After the initialize response, the client sends an \",(0,n.jsx)(e.code,{children:\"initialized\"}),\" notification to confirm the session is ready.\"]}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{children:`Client \\u2192 Server: initialize request\\r\nServer \\u2192 Client: capabilities + server info\\r\nClient \\u2192 Server: initialized notification\\r\n\\u2705 Session established\n`})}),`\n`,(0,n.jsx)(e.h3,{children:\"Phase 2: Operation\"}),`\n`,(0,n.jsxs)(e.p,{children:[\"The host can now discover tools and call them through the client. This is where actual work happens. The client sends \",(0,n.jsx)(e.code,{children:\"tools/list\"}),\" to discover available tools, then \",(0,n.jsx)(e.code,{children:\"tools/call\"}),\" with the tool name and arguments to execute specific ones. Resources can be accessed via \",(0,n.jsx)(e.code,{children:\"resources/read\"}),\" for read-only data access.\"]}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-json\",children:`// Tool discovery\\r\n{\"method\": \"tools/list\"}\\r\n\\r\n// Tool execution\\r\n{\"method\": \"tools/call\", \"params\": {\"name\": \"add_expense\", \"arguments\": {\"amount\": 42.50, \"category\": \"food\"}}}\\r\n\\r\n// Resource access\\r\n{\"method\": \"resources/read\", \"params\": {\"uri\": \"file:///expenses/january.json\"}}\n`})}),`\n`,(0,n.jsxs)(e.p,{children:[\"Each tool call returns structured content with type, text, and optional metadata. Resources follow a similar pattern via \",(0,n.jsx)(e.code,{children:\"resources/read\"}),\" but are read-only and cacheable. The key difference: tools are for actions that modify state, resources are for retrieving data without side effects.\"]}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"Important rule:\"}),\" Resources can be cached aggressively by the LLM. Tools must be called fresh each time because they may have side effects. MCP servers advertise both capabilities, and the client decides which to use based on what the LLM needs at each step.\"]}),`\n`,(0,n.jsx)(e.h3,{children:\"Phase 3: Shutdown\"}),`\n`,(0,n.jsx)(e.p,{children:\"The session ends when either side terminates. Connection closes cleanly and resources are released. To use the server again, full initialization is required.\"}),`\n`,(0,n.jsx)(e.h2,{children:\"Tools vs Resources: Critical Distinction\"}),`\n`,(0,n.jsx)(e.p,{children:\"MCP defines two types of capabilities with different semantics. Choosing the right one matters for correctness and performance.\"}),`\n`,(0,n.jsxs)(e.table,{children:[(0,n.jsx)(e.thead,{children:(0,n.jsxs)(e.tr,{children:[(0,n.jsx)(e.th,{children:\"Aspect\"}),(0,n.jsx)(e.th,{children:\"Tool\"}),(0,n.jsx)(e.th,{children:\"Resource\"})]})}),(0,n.jsxs)(e.tbody,{children:[(0,n.jsxs)(e.tr,{children:[(0,n.jsx)(e.td,{children:\"Side effects\"}),(0,n.jsx)(e.td,{children:\"Yes (modifies state)\"}),(0,n.jsx)(e.td,{children:\"No (read-only)\"})]}),(0,n.jsxs)(e.tr,{children:[(0,n.jsx)(e.td,{children:\"Invocation\"}),(0,n.jsx)(e.td,{children:\"Active (explicit call)\"}),(0,n.jsx)(e.td,{children:\"Passive (data retrieval)\"})]}),(0,n.jsxs)(e.tr,{children:[(0,n.jsx)(e.td,{children:\"Use case\"}),(0,n.jsx)(e.td,{children:\"Actions\"}),(0,n.jsx)(e.td,{children:\"Context/Information\"})]}),(0,n.jsxs)(e.tr,{children:[(0,n.jsx)(e.td,{children:\"Caching\"}),(0,n.jsx)(e.td,{children:\"Unsafe\"}),(0,n.jsx)(e.td,{children:\"Safe\"})]}),(0,n.jsxs)(e.tr,{children:[(0,n.jsx)(e.td,{children:\"Idempotency\"}),(0,n.jsx)(e.td,{children:\"Often not idempotent\"}),(0,n.jsx)(e.td,{children:\"Idempotent\"})]})]})]}),`\n`,(0,n.jsx)(e.p,{children:(0,n.jsx)(e.strong,{children:\"Tool example (side effects):\"})}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`@server.tool()\\r\nasync def send_slack_message(channel: str, text: str):\\r\n    slack_client.post_message(channel, text)\\r\n    return {\"sent\": True}\n`})}),`\n`,(0,n.jsx)(e.p,{children:\"This modifies state by sending a message. Must be called fresh each time, result should not be cached.\"}),`\n`,(0,n.jsx)(e.p,{children:(0,n.jsx)(e.strong,{children:\"Resource example (read-only):\"})}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`@server.resource(\"file:///{path}\")\\r\nasync def read_file(path: str):\\r\n    content = filesystem.read(path)\\r\n    return {\"uri\": f\"file:///{path}\", \"mimeType\": \"text/plain\", \"text\": content}\n`})}),`\n`,(0,n.jsx)(e.p,{children:\"No side effects \\u2014 just returns data. LLMs can cache resource responses aggressively.\"}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"Why this matters:\"}),\" Resources enable efficient context loading \\u2014 the LLM can pull in large amounts of reference data without worrying about stale caches. Tools enable AI to take real actions in the world. MCP servers advertise both, and the client decides which to use based on what the LLM needs at each step. Using a tool when a resource would suffice means wasted latency and potential side effects. Using a resource when a tool is needed means stale or incorrect data.\"]}),`\n`,(0,n.jsx)(e.h2,{children:\"Transport Layer: How Data Moves\"}),`\n`,(0,n.jsx)(e.p,{children:\"Transport is orthogonal to MCP protocol semantics. Same protocol, different delivery mechanisms:\"}),`\n`,(0,n.jsxs)(e.ul,{children:[`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"STDIO Transport\"}),\" \\u2014 standard input/output pipes between processes. Ultra-low latency (\",(0,n.jsx)(e.code,{children:\"<1ms\"}),\"), maximum security (local-only). Best for local development and desktop applications. Configured via \",(0,n.jsx)(e.code,{children:\"claude_desktop_config.json\"}),\" with command and args. The parent process (Claude Desktop) spawns your server as a child process and communicates through stdin/stdout pipes.\"]}),`\n`]}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-json\",children:`{\\r\n  \"mcpServers\": {\\r\n    \"my-server\": {\\r\n      \"command\": \"python\",\\r\n      \"args\": [\"/path/to/server.py\"]\\r\n    }\\r\n  }\\r\n}\n`})}),`\n`,(0,n.jsxs)(e.ul,{children:[`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"HTTP + SSE Transport\"}),\" \\u2014 HTTP for requests, Server-Sent Events for streaming responses. Best for remote/cloud servers and team collaboration. Network latency 20-100ms. Requires a hosted server but enables remote access and real-time streaming. Uses Starlette or FastAPI to serve the SSE endpoint.\"]}),`\n`]}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`from mcp.server.sse import SseServerTransport\\r\nfrom starlette.applications import Starlette\\r\n\\r\napp = Starlette()\\r\nsse = SseServerTransport(\"/messages\")\\r\n\\r\n@app.route(\"/sse\")\\r\nasync def handle_sse(request):\\r\n    async with sse.connect_sse(request.scope, request.receive, request._send) as streams:\\r\n        await server.run(streams[0], streams[1], init_options)\n`})}),`\n`,(0,n.jsxs)(e.ul,{children:[`\n`,(0,n.jsxs)(e.li,{children:[(0,n.jsx)(e.strong,{children:\"Streamable HTTP Transport\"}),\" \\u2014 designed for serverless platforms like Vercel, Cloudflare Workers, and AWS Lambda. Auto-scaling with cold start latency 50-200ms. Perfect for production APIs where you don't want to manage a long-running server.\"]}),`\n`]}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-typescript\",children:`import { Server } from \"@modelcontextprotocol/sdk/server\";\\r\nimport { StreamableHTTPTransport } from \"@modelcontextprotocol/sdk/server/http\";\\r\n\\r\nexport const config = { runtime: \"edge\" };\\r\nconst server = new Server({ name: \"serverless-mcp\", version: \"1.0.0\" });\\r\n\\r\nexport default async function handler(req: Request) {\\r\n  const transport = new StreamableHTTPTransport();\\r\n  return transport.handleRequest(req, server);\\r\n}\n`})}),`\n`,(0,n.jsxs)(e.table,{children:[(0,n.jsx)(e.thead,{children:(0,n.jsxs)(e.tr,{children:[(0,n.jsx)(e.th,{children:\"Feature\"}),(0,n.jsx)(e.th,{children:\"STDIO\"}),(0,n.jsx)(e.th,{children:\"HTTP+SSE\"}),(0,n.jsx)(e.th,{children:\"Streamable HTTP\"})]})}),(0,n.jsxs)(e.tbody,{children:[(0,n.jsxs)(e.tr,{children:[(0,n.jsx)(e.td,{children:\"Latency\"}),(0,n.jsx)(e.td,{children:(0,n.jsx)(e.code,{children:\"<1ms\"})}),(0,n.jsx)(e.td,{children:\"20-100ms\"}),(0,n.jsx)(e.td,{children:\"50-200ms\"})]}),(0,n.jsxs)(e.tr,{children:[(0,n.jsx)(e.td,{children:\"Location\"}),(0,n.jsx)(e.td,{children:\"Local only\"}),(0,n.jsx)(e.td,{children:\"Remote\"}),(0,n.jsx)(e.td,{children:\"Remote\"})]}),(0,n.jsxs)(e.tr,{children:[(0,n.jsx)(e.td,{children:\"Deployment\"}),(0,n.jsx)(e.td,{children:\"Simple\"}),(0,n.jsx)(e.td,{children:\"Medium\"}),(0,n.jsx)(e.td,{children:\"Simple\"})]}),(0,n.jsxs)(e.tr,{children:[(0,n.jsx)(e.td,{children:\"Serverless\"}),(0,n.jsx)(e.td,{children:\"No\"}),(0,n.jsx)(e.td,{children:\"No\"}),(0,n.jsx)(e.td,{children:\"Yes\"})]}),(0,n.jsxs)(e.tr,{children:[(0,n.jsx)(e.td,{children:\"Best for\"}),(0,n.jsx)(e.td,{children:\"Development\"}),(0,n.jsx)(e.td,{children:\"Team tools\"}),(0,n.jsx)(e.td,{children:\"Production\"})]})]})]}),`\n`,(0,n.jsx)(e.p,{children:\"Choosing the right transport depends on your use case. Start with STDIO during development for fast iteration, then switch to Streamable HTTP for production deployment with auto-scaling. Use HTTP+SSE when you need real-time streaming for long-running operations.\"}),`\n`,(0,n.jsx)(e.h2,{children:\"Building an MCP Server in Practice\"}),`\n`,(0,n.jsx)(e.p,{children:\"Here's a complete example of an expense tracking MCP server:\"}),`\n`,(0,n.jsx)(e.pre,{children:(0,n.jsx)(e.code,{className:\"language-python\",children:`from mcp.server import Server\\r\n\\r\nserver = Server(\"expense-tracker\")\\r\n\\r\n@server.list_tools()\\r\nasync def list_tools():\\r\n    return [\\r\n        {\\r\n            \"name\": \"add_expense\",\\r\n            \"description\": \"Add an expense to the tracker\",\\r\n            \"inputSchema\": {\\r\n                \"type\": \"object\",\\r\n                \"properties\": {\\r\n                    \"amount\": {\"type\": \"number\", \"description\": \"Amount in dollars\"},\\r\n                    \"category\": {\"type\": \"string\", \"description\": \"Category like food, transport\"},\\r\n                    \"description\": {\"type\": \"string\", \"description\": \"Optional description\"}\\r\n                },\\r\n                \"required\": [\"amount\", \"category\"]\\r\n            }\\r\n        },\\r\n        {\\r\n            \"name\": \"get_summary\",\\r\n            \"description\": \"Get expense summary by category\",\\r\n            \"inputSchema\": {\"type\": \"object\", \"properties\": {}}\\r\n        }\\r\n    ]\\r\n\\r\n@server.call_tool()\\r\nasync def call_tool(name, arguments):\\r\n    if name == \"add_expense\":\\r\n        db.insert(arguments)\\r\n        return {\"content\": [{\"type\": \"text\", \"text\": f\"Added \\${arguments['amount']} to {arguments['category']}\"}]}\\r\n    elif name == \"get_summary\":\\r\n        summary = db.get_summary()\\r\n        return {\"content\": [{\"type\": \"text\", \"text\": format_summary(summary)}]}\n`})}),`\n`,(0,n.jsx)(e.p,{children:\"This server exposes two tools. Any MCP-compatible client \\u2014 Claude Desktop, VS Code, Cursor, your custom app \\u2014 can discover and use them without writing any integration code. The same server works everywhere.\"}),`\n`,(0,n.jsx)(e.h2,{children:\"Security Considerations\"}),`\n`,(0,n.jsx)(e.p,{children:\"MCP's architecture provides several security properties by design. The 1:1 client-server model means each integration is isolated \\u2014 a crash or compromise in one server doesn't affect others. Hosts never talk directly to servers, creating a clear security boundary. STDIO transport keeps communication local when needed, eliminating network attack surface.\"}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"Permission scoping:\"}),\" Each server can authenticate independently. A GitHub server uses GitHub OAuth, while a database server uses database credentials. There's no shared auth context that could leak between services.\"]}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"Capability negotiation:\"}),\" During initialization, servers advertise exactly what they can do. Clients can inspect capabilities before granting access. This prevents servers from performing unexpected operations.\"]}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"Transport security:\"}),\" HTTP+SSE and Streamable HTTP transports can use TLS for encryption. STDIO transport is inherently secure since communication never leaves the local machine.\"]}),`\n`,(0,n.jsx)(e.h2,{children:\"Why MCP Matters\"}),`\n`,(0,n.jsx)(e.p,{children:\"MCP solves a specific technical problem: standardizing AI-to-tool communication. It does this through clear architecture (Host, Client, Server separation), strict protocol (JSON-RPC with defined lifecycle), capability system (Tools, Resources, Prompts), transport flexibility (STDIO, HTTP, Serverless), and the 1:1 client-server model for isolation and fault containment.\"}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"What MCP enables:\"}),\" Write tool servers once, use everywhere. N+M instead of N\\xD7M integrations. Natural language interfaces for data. Decoupled, scalable AI systems.\"]}),`\n`,(0,n.jsxs)(e.p,{children:[(0,n.jsx)(e.strong,{children:\"What MCP doesn't do:\"}),\" Make your LLM smarter, handle prompt engineering, provide reasoning logic, or replace your application architecture. MCP is infrastructure \\u2014 use it when you need AI to reliably access external systems.\"]}),`\n`,(0,n.jsx)(e.p,{children:\"If you are building AI software that talks to other software, MCP is the abstraction worth learning.\"})]})}function h(r={}){let{wrapper:e}=r.components||{};return e?(0,n.jsx)(e,{...r,children:(0,n.jsx)(d,{...r})}):d(r)}return b(P);})();\n;return Component;"